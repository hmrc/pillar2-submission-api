meta {
  name: Create Organisation
  type: http
  seq: 1
}

post {
  url: {{externalTestStubUrl}}/pillar2/test/organisation/{{testPlrId}}
  body: json
  auth: none
}

body:json {
  {
    "orgDetails": {
      "domesticOnly": false,
      "organisationName": "Test Organisation Ltd",
      "registrationDate": "2024-01-01"
    },
    "accountingPeriod": {
      "startDate": "2024-01-01",
      "endDate": "2024-12-31"
    }
  }
}

assert {
  res.status: eq 201
  res.body.pillar2Id: eq {{testPlrId}}
  res.body.organisation: isDefined
  res.body.organisation.orgDetails: isDefined
  res.body.organisation.accountingPeriod: isDefined
  res.body.organisation.accountStatus: isDefined
  res.body.organisation.lastUpdated: isDefined
}

script:pre-request {
  if (bru.getEnvVar("environment") !== 'local') {
    if (req.getExecutionMode() == "standalone") {
      throw new Error('Environment must be set to Local.');
    } else {
      bru.runner.skipRequest();
      return;
    }
  }
  
  if (bru.getVar("organisationCreatedFor") === bru.getEnvVar("testPlrId")) {
    throw new Error("Organisation already created. Run the 'Delete Organisation' request first.");
  }
  
}

script:post-response {
  if (res.getStatus() === 201 || res.getStatus() === 409) {
    bru.setVar("organisationCreatedFor", bru.getEnvVar("testPlrId"));
  }
}
