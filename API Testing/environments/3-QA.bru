vars {
  environment: qa
  url: https://api.qa.tax.service.gov.uk
  apiUrl: {{url}}/organisations/pillar-two
  auth_code_url: https://www.qa.tax.service.gov.uk
  headlessPlaywright: true
  accessCode: 123456
}
vars:secret [
  clientId,
  clientSecret,
  governmentGatewayId,
  governmentGatewayPassword,
  governmentGatewayPlrId,
  bearerToken,
  refreshToken,
  applicationToken,
  authCode,
  testPlrId
]
