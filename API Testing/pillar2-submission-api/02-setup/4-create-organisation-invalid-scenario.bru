meta {
  name: Create Organisation (Invalid Scenario)
  type: http
  seq: 4
}

post {
  url: {{apiUrl}}/setup/organisation
  body: json
  auth: none
}

headers {
  Authorization: {{bearerToken}}
  X-Pillar2-Id: {{testPlrId}}
}

body:json {
  {
    "orgDetails": {
      "domesticOnly": false,
      "organisationName": "Test Organisation Ltd",
      "registrationDate": "2024-01-01"
    },
    "accountingPeriod": {
      "startDate": "2024-01-01",
      "endDate": "2024-12-31"
    },
    "testData": {
      "accountActivityScenario": "INVALID_SCENARIO"
    }
  }
}

assert {
  res.status: eq 400
  res.body: isNotEmpty
  res.body.code: eq "INVALID_JSON"
  res.body.message: eq "Invalid JSON payload"
}

script:pre-request {
  if (bru.getEnvVar("organisationCreated") === true) {
    throw new Error('Organisation already exists. Run the "Delete Organisation" request first.');
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("organisationCreated", true);
  }
}
