meta {
  name: Create Organisation (Domestic)
  type: http
  seq: 2
}

post {
  url: {{apiUrl}}/setup/organisation
  body: json
  auth: none
}

headers {
  Authorization: {{bearerToken}}
  X-Pillar2-Id: {{testPlrId}}
}

body:json {
  {
    "orgDetails": {
      "domesticOnly": true,
      "organisationName": "Test Organisation Ltd",
      "registrationDate": "2024-01-01"
    },
    "accountingPeriod": {
      "startDate": "2024-01-01",
      "endDate": "2024-12-31"
    }
  }
}

assert {
  res.status: eq 201
  res.body.pillar2Id: eq {{testPlrId}}
  res.body.organisation: isNotEmpty
  res.body.organisation.orgDetails.domesticOnly: eq true
  res.body.organisation.accountingPeriod: isNotEmpty
}
