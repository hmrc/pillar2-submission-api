meta {
  name: Delete Organisation
  type: http
  seq: 7
}

delete {
  url: {{apiUrl}}/setup/organisation
  body: none
  auth: none
}

headers {
  Authorization: {{bearerToken}}
  X-Pillar2-Id: {{testPlrId}}
}

assert {
  res.status: eq 204
  res.body: isEmpty
}

script:pre-request {
  if (bru.getEnvVar("organisationCreated") === false) {
    throw new Error('Organisation has not been created. Run a "Create Organisation" request first.');
  }
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setEnvVar("organisationCreated", false);
  }
}
