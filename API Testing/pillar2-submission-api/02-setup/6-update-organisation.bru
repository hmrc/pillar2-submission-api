meta {
  name: Update Organisation
  type: http
  seq: 6
}

put {
  url: {{apiUrl}}/setup/organisation
  body: json
  auth: none
}

headers {
  Authorization: {{bearerToken}}
  X-Pillar2-Id: {{testPlrId}}
}

body:json {
  { 
    "orgDetails": {
      "domesticOnly": true,
      "organisationName": "Updated Test Organisation Ltd",
      "registrationDate": "2024-01-01"
    },
    "accountingPeriod": {
      "startDate": "2024-01-01",
      "endDate": "2024-12-31"
    },
    "testData": {
      "accountActivityScenario": "DTT_CHARGE"
    }
  }
}

assert {
  res.status: eq 200
  res.body.pillar2Id: eq {{testPlrId}}
  res.body.organisation: isNotEmpty
  res.body.organisation.orgDetails.organisationName: eq "Updated Test Organisation Ltd"
  res.body.organisation.accountingPeriod: isNotEmpty
}

script:pre-request {
  if (bru.getVar("organisationCreatedFor") !== bru.getEnvVar("testPlrId")) {
    throw new Error('Organisation has not been created. Run a "Create Organisation" request first.');
  }
}
