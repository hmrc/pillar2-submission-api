meta {
  name: Create Refresh Token
  type: http
  seq: 5
}

post {
  url: {{url}}/oauth/token
  body: formUrlEncoded
  auth: none
}

headers {
  content-type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
  grant_type: refresh_token
  refresh_token: {{refreshToken}}
}

assert {
  res.status: eq 200
  res.body.access_token: isNotEmpty
  res.body.refresh_token: isNotEmpty
  res.body.scope: eq "write:pillar2 read:pillar2"
  res.body.token_type: eq "bearer"
}

script:pre-request {
  if (!bru.getEnvVar("clientId")) {
    throw new Error('Please set the value of "clientId" in the environment configuration.');
  }
  
  if (!bru.getEnvVar("clientSecret")) {
    throw new Error('Please set the value of "clientSecret" in the environment configuration.');
  }
  
  if (!bru.getEnvVar("refreshToken")) {
    throw new Error('"refreshToken" not set. Run the "Exchange Auth Code" request first.');
  }
}

script:post-response {
  bru.setEnvVar("bearerToken", "Bearer " + res.body.access_token)
  bru.setEnvVar("refreshToken", res.body.refresh_token)
}
