meta {
  name: Get Auth Code
  type: http
  seq: 3
}

get {
  url: {{auth_code_url}}/oauth/authorize?client_id={{clientId}}&redirect_uri=urn:ietf:wg:oauth:2.0:oob&scope=write:pillar2 read:pillar2&response_type=code
  body: none
  auth: none
}

params:query {
  client_id: {{clientId}}
  redirect_uri: urn:ietf:wg:oauth:2.0:oob
  scope: write:pillar2 read:pillar2
  response_type: code
  ~testUserId: {{testUserId}}
  ~testUserPassword: {{testUserPassword}}
}

script:pre-request {
  const helpers = require('./_lib/helpers');
  
  const ggUserId   = bru.getEnvVar('governmentGatewayId');
  const ggPassword = bru.getEnvVar('governmentGatewayPassword');
  
  if (bru.getEnvVar('environment') === 'qa') {
    if (!ggUserId || !ggPassword) {
      throw new Error('QA environment requires "governmentGatewayId" and "governmentGatewayPassword" env vars (your Government Gateway sign-in details).');
    }
  } else {
    if (!bru.getEnvVar('testUserId'))      {
      throw new Error('"testUserId" not set. Run the "Create Test User" request first.');
    }
    if (!bru.getEnvVar('testUserPassword')) {
      throw new Error('"testUserPassword" not set. Run the "Create Test User" request first.');
    }
    if (!bru.getEnvVar('testPlrId')) {
      throw new Error('"testPlrId" not set. Run the "Create Test User" request first.');
    }
  }
  
  const code = await helpers.getAuthCode({
    authCodeUrl: bru.getEnvVar('auth_code_url'),
    clientId:    bru.getEnvVar('clientId'),
    userId:      ggUserId   || bru.getEnvVar('testUserId'),
    password:    ggPassword || bru.getEnvVar('testUserPassword'),
    accessCode:  bru.getEnvVar('accessCode'),
    headless:    bru.getEnvVar('headlessPlaywright') !== 'false',
  });
  
  bru.setEnvVar('authCode', code);
}
