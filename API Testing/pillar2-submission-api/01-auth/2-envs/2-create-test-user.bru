meta {
  name: Create Test User
  type: http
  seq: 2
}

post {
  url: {{url}}/create-test-user/organisations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{applicationToken}}
}

body:json {
  {
    "serviceNames": [
      "pillar-2"
    ]
  }
}

assert {
  res.status: eq 201
  res.body.userId: isNotEmpty
  res.body.password: isNotEmpty
  res.body.pillar2Id: isNotEmpty
}

script:pre-request {
  if (bru.getEnvVar("environment") == 'qa') {
    throw new Error('Do not run this request on QA environment to generate testUserID and testUserPassword. The Government Gateway credentials (environment variables) are used.');
  }
  if (!bru.getEnvVar("applicationToken")) {
    throw new Error('"applicationToken" not set. Run the "Create Bearer Token" request first.');
  }
}

script:post-response {
  bru.setEnvVar("testUserId", res.body.userId)
  bru.setEnvVar("testUserPassword", res.body.password)
  bru.setEnvVar("testPlrId", res.body.pillar2Id)
}
